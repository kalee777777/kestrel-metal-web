{
  "name": "kestrel-metal-web",
  "compatibility_date": "2026-08-16",
  "main": "src/index.ts",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SEO_DATA",
      "id": "38d58d037ca147a4824db92938bd520b"
    },
    {
      "binding": "CONTENT_QUEUE",
      "id": "bff7d65e2d2c4512a70f24b5dae0c92f"
    },
    {
      "binding": "SCORE_LOG",
      "id": "1ca4adf676cf4afe94ccfb163ac8c692"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "kestrel-images",
      "preview_bucket_name": "kestrel-images-preview"
    }
  ],
  "triggers": {
    "crons": [
      "0 19 * * *",
      "0 20 * * 1",
      "0 21 * * 1",
      "0 16 1 * *"
    ]
  },
  "vars": {
    "SITE_URL": "https://kestrelmetal.com",
    "DEEPSEEK_MODEL": "deepseek-chat"
  }
}
